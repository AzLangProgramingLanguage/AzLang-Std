enum FD
    Stdin
    Stdout
    Stderr

enum FLAG
    ReadOnly
    Write

enum FMODE
    NoCreate
    Create

@link("./sdk/src/exit.s")
op exit(const int val): void


@link("./sdk/src/write.s")
op write(FD fd,const str val,const int size): void

@link("./sdk/src/fopen.s")
op fopen(const str val, FLAG flag, FMODE mode): File
