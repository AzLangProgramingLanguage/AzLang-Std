
enum FD
    Stdin
    Stdout
    Stderr

enum FLAG
    ReadOnly
    Write

enum FMODE
    NoCreate
    Create



@link("./sdk/build/exit.o")
func exit(const int val): void


@link("./sdk/build/write.o")
func write(FD fd,const str val,const int size): void

@link("./sdk/build/fopen.o")
func fopen(const str val, FLAG flag, FMODE mode): void

