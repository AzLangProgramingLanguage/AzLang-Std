
enum FD
    Stdin
    Stdout
    Stderr

enum FLAG
    ReadOnly
    Write

enum FMODE
    NoCreate
    Create

@link("./sdk/build/exit.o")
op exit(const int val): void


@link("./sdk/build/write.o")
op write(FD fd,const str val,const int size): void

@link("./sdk/build/fopen.o")
op fopen(const str val, FLAG flag, FMODE mode): void

fopen("/etc/os-release",ReadOnly, NoCreate)

if 1==1
    write(Stdout,"Hello World",11)
